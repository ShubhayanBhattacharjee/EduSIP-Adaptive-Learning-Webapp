PORT=5000
MONGO_URI=
CLIENT_URL=http://localhost:3000

# Public login (students, teachers) and staff login (admins, super admins)
JWT_SECRET=
JWT_EXPIRE=7d
STAFF_JWT_EXPIRE=8h
# TEMPORARY. true = admins may still use the normal /auth/login form until the staff login page exists in the frontend.
LEGACY_STAFF_LOGIN=false

# Set to 1 when the server sits behind a proxy / load balancer (Render, Nginx, ...)
TRUST_PROXY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

EMAIL_USER=
EMAIL_PASS=
# local testing only: skips the verification email
SKIP_EMAIL_VERIFICATION=false

YOUTUBE_API_KEY=

# Python ML service (the ML folder). ML_API_KEY must be the same value in the ML folder's .env
ML_URL=http://127.0.0.1:8000
ML_API_KEY=
FORCE_ADAPTIVE=true
RECONCILE_MINUTES=10
DEFAULT_SECONDS_PER_QUESTION=120

PLACEMENT_SIZE=10
PLACEMENT_RETAKE_DAYS=90
REQUIRE_PLACEMENT=false
